<% return if collection.blank? %>

<div class="py-1">
  <div class="text-xs font-semibold text-gray-500 px-2">
    <%= title %>
  </div>

  <div class="relative overflow-x-auto sm:rounded-lg py-1" style="white-space: nowrap">
    <%= render partial: partial, collection: collection, as: as %>

    <hr class="h-px my-2 px-4 bg-gray-300 border-0 dark:bg-gray-700">
  </div>
</div>