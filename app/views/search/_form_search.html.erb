<%= form_with url: '', method: :get, class: "max-w", data: { controller: "search", action: "submit->search#preventSubmit" } do |form| %>
  <label class="<%= search_label_class %>">Search</label>
  <div class="relative">
    <div class="<%= svg_wrapper_class %>">
      <svg class="w-4 h-4 text-gray-500 dark:text-gray-400" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 20 20">
        <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m19 19-4-4m0-7A7 7 0 1 1 1 8a7 7 0 0 1 14 0Z"/>
      </svg>
    </div>

    <%= form.text_field(:user,
                        data:{controller: "search", action:"input->search#findAll", search_target: "searchInput"},
                        class: search_form_class,
                        placeholder: "Search") %>

  </div>
<% end %>