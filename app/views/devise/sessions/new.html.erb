<div class="<%= auth_form_wrapper_class %>">
  <h2 class="<%= auth_title_class %>">
    Log in
  </h2>

  <%= form_for(resource, as: resource_name,
               url: session_path(resource_name),
               html: { class: "space-y-5" }) do |f| %>

    <div>
      <%= f.label :email, class: auth_label_class %>
      <%= f.email_field :email,
                        autofocus: true,
                        autocomplete: "email",
                        class: auth_input_class %>
    </div>

    <div>
      <%= f.label :password, class: auth_label_class %>
      <%= f.password_field :password,
                           autocomplete: "current-password",
                           class: auth_input_class %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-2">
        <%= f.check_box :remember_me, class: auth_checkbox_class %>
        <%= f.label :remember_me, class: "text-sm text-gray-900 dark:text-gray-300" %>
      </div>
    <% end %>

    <%= f.submit "Log in", class: auth_submit_class %>

  <% end %>

  <%= render "devise/shared/links" %>
</div>