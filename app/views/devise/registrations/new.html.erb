<div class="<%= auth_form_wrapper_class %>">
  <h2 class="<%= auth_title_class %>">
    Sign up
  </h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: "space-y-5" }) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= f.label :name, class: auth_label_class %>
      <%= f.text_field :name, autofocus: true, autocomplete: "name", class: auth_input_class %>
    </div>

    <div>
      <%= f.label :email, class: auth_label_class %>
      <%= f.email_field :email, autofocus: true, autocomplete: "email", class: auth_input_class %>
    </div>

    <div>
      <%= f.label :password, class: auth_label_class %>
      <% if @minimum_password_length %>
        <em>(<%= @minimum_password_length %> characters minimum)</em>
      <% end %><br/>
      <%= f.password_field :password, autocomplete: "new-password", class: auth_input_class %>
    </div>

    <div>
      <%= f.label :password_confirmation, class: auth_label_class %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: auth_input_class %>
    </div>

    <%= f.submit "Sign up", class: auth_submit_class %>

  <% end %>
  <%= render "devise/shared/links" %>
</div>

